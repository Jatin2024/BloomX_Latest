# Runtime API configuration used by client-side requests.
# Leave empty to use same-origin requests (for example, /api via reverse proxy).
VITE_API_BASE_URL=

# API prefix appended before endpoint paths.
VITE_API_PREFIX=/api

# Dev server proxy target used by client/vite.config.js.
# Runtime helper also falls back to this value when VITE_API_BASE_URL is not set.
VITE_API_URL=http://localhost:5001
